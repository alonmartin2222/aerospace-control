<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.aerospace-control.watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
        <string>--watch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/aerospace-control-watcher.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/aerospace-control-watcher.err</string>
</dict>
</plist>
