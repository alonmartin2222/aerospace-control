<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.aerospace-control.watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
        <string>--watch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Single log: NSLog writes to stderr and shell() output to stdout, but
         users expect one file to tail. Point both at .log so everything ends
         up in one place. -->
    <key>StandardOutPath</key>
    <string>/tmp/aerospace-control-watcher.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/aerospace-control-watcher.log</string>
</dict>
</plist>
